   "$from": "Light: ui ToolWindow.Button.foreground → Gray5 → #5A5D6B"
  },
  "border-color-default": {
   "$alias": "jb-gray-12",
   "$from": "Light: ui Borders.color → Gray12 → #EBECF0"
  },
  "border-color-emphasis": {
   "$alias": "jb-gray-9",
   "$from": "Light: ui Component.borderColor → Gray9 → #C9CCD6"
  },
  "separator-color": {
   "$alias": "jb-gray-12",
   "$from": "Light: ui *.separatorColor → Gray12 → #EBECF0"
  },
  "accent-color-default": {
   "$alias": "jb-blue-4",
   "$from": "Light: ui Button.default.startBackground → Blue4 → #3574F0"
  },
  "accent-content-color-on-accent": {
   "$alias": "jb-gray-14",
   "$from": "Light: ui Button.default.foreground → Gray14 → #FFFFFF"
  },
  "accent-background-color-default": {
   "$alias": "jb-blue-11",
   "$from": "Light: ui *.selectionBackground → Blue11 → #D4E2FF"
  },
  "accent-content-color-on-background": {
   "$alias": "jb-gray-1",
   "$from": "Light: ui *.selectionForeground → Gray1 → #000000"
  },
  "accent-background-color-inactive": {
   "$alias": "jb-gray-11",
   "$from": "Light: ui *.selectionInactiveBackground → Gray11 → #DFE1E5"
  },
  "focus-color": {
   "$alias": "jb-blue-4",
   "$from": "Light: ui *.focusColor → Blue4 → #3574F0"
  },
  "negative-color-default": {
   "$alias": "jb-red-3",
   "$from": "Light with Light Header: color Red3 → #CC3645"
  },
  "negative-background-color-default": {
   "$alias": "jb-red-11",
   "$from": "Light: ui ValidationTooltip.errorBackground → Red11 → #FFF2F3"
  },
  "negative-border-color": {
   "$alias": "jb-red-7",
   "$from": "Light: ui ValidationTooltip.errorBorderColor → Red7 → #ED99A1"
  },
