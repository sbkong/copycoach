   "$from": "Light: ui Editor.ToolTip.successBackground → Green11 → #F2FCF3"
  },
  "tooltip-background-color": {
   "$alias": "jb-gray-14",
   "$from": "Light with Light Header: ui ToolTip.background → Gray14 → #FFFFFF"
  },
  "tooltip-content-color": {
   "$alias": "jb-gray-1",
   "$from": "Light with Light Header: ui ToolTip.foreground → Gray1 → #000000"
  },
  "overlay-scrim-color": {
   "$alias": "jb-gray-1",
   "$from": "Light with Light Header: color Gray1 → #000000"
  },
  "chord-c-color": {
   "$alias": "okabe-yellow"
  },
  "chord-dm-color": {
   "$alias": "okabe-reddishpurple"
  },
  "chord-em-color": {
   "$alias": "okabe-vermilion"
  },
  "chord-f-color": {
   "$alias": "okabe-skyblue"
  },
  "chord-g-color": {
   "$alias": "okabe-bluishgreen"
  },
  "chord-am-color": {
   "$alias": "okabe-blue"
