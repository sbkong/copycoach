  "degree-third-color": {
   "$alias": "okabe-skyblue"
  },
  "degree-fifth-color": {
   "$alias": "okabe-blue"
  },
  "degree-seventh-color": {
   "$alias": "okabe-reddishpurple"
  },
  "degree-tension-color": {
   "$alias": "okabe-vermilion"
  },
  "stem-vocals-color": {
   "$alias": "okabe-reddishpurple"
  },
  "stem-drums-color": {
   "$alias": "okabe-orange"
  },
  "stem-bass-color": {
   "$alias": "okabe-blue"
  },
  "stem-other-color": {
   "$alias": "okabe-yellow"
  },
  "stem-guitar-color": {
   "$alias": "okabe-vermilion"
  },
  "stem-piano-color": {
   "$alias": "okabe-skyblue"
  }
