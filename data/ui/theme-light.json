 "semantic": {
  "background-canvas-color": {
   "$alias": "jb-gray-13",
   "$from": "Light: ui *.background → Gray13 → #F7F8FA"
  },
  "background-layer-1-color": {
   "$alias": "jb-gray-13",
   "$from": "Light: ui ToolWindow.background → Gray13 → #F7F8FA"
  },
  "background-content-color": {
   "$alias": "jb-gray-14",
   "$from": "Light: ui EditorTabs.background → Gray14 → #FFFFFF"
  },
  "background-inline-color": {
   "$alias": "jb-gray-14",
   "$from": "Light: ui TextField.background → Gray14 → #FFFFFF"
  },
  "background-layer-2-color": {
   "$alias": "jb-gray-14",
   "$from": "Light: ui Popup.background → Gray14 → #FFFFFF"
  },
  "background-layer-3-color": {
   "$alias": "jb-gray-14",
   "$from": "Light: ui ComboBox.ArrowButton.nonEditableBackground → Gray14 → #FFFFFF"
  },
  "background-elevated-color": {
   "$alias": "jb-gray-14",
   "$from": "Light: ui Notification.ToolWindow.informativeBackground → Gray14 → #FFFFFF"
  },
  "background-hover-color": {
   "$alias": "jb-blue-12",
   "$from": "Light: ui *.hoverBackground → Blue12 → #EDF3FF"
  },
  "background-pressed-color": {
   "$alias": "jb-pressed-overlay",
   "$from": "Light: ui ActionButton.pressedBackground → #0000001D"
  },
  "content-color-default": {
   "$alias": "jb-gray-1",
   "$from": "Light with Light Header: ui MainMenu.foreground → Gray1 → #000000"
  },
  "content-color-secondary": {
   "$alias": "jb-gray-6",
   "$from": "Light: ui StatusBar.Widget.foreground → Gray6 → #6C707E"
  },
  "content-color-tertiary": {
   "$alias": "jb-gray-7",
   "$from": "Light: ui *.infoForeground → Gray7 → #818594"
  },
  "content-color-disabled": {
   "$alias": "jb-gray-8",
   "$from": "Light: ui *.disabledForeground → Gray8 → #A8ADBD"
  },
  "content-color-link": {
   "$alias": "jb-blue-2",
   "$from": "Light: ui Link.activeForeground → Blue2 → #315FBD"
  },
  "icon-color-default": {
