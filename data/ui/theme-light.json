 "component": {
  "fretboard-string-color": {
   "$alias": "border-color-emphasis"
  },
  "fretboard-fret-color": {
   "$alias": "border-color-default"
  },
  "fretboard-marker-color": {
   "$alias": "background-layer-3-color"
  },
  "fretboard-dot-label-color": {
   "$computed": "on_color(dot fill)"
  },
  "waveform-fill-color": {
   "$alias": "content-color-secondary"
  },
  "waveform-grid-beat-color": {
   "$alias": "border-color-default"
  },
  "waveform-grid-bar-color": {
   "$alias": "negative-color-default"
  },
  "playhead-color": {
   "$alias": "accent-color-default"
  },
  "sync-point-color": {
   "$alias": "content-color-default"
  },
  "score-notation-color": {
   "$alias": "content-color-default"
  },
  "score-cursor-voice-1-color": {
   "$alias": "accent-color-default"
  },
  "score-cursor-voice-2-color": {
   "$alias": "degree-root-color"
  },
  "selection-color": {
   "$alias": "accent-background-color-default"
  },
  "keyboard-white-key-color": {
   "$alias": "jb-gray-14"
  },
  "keyboard-black-key-color": {
   "$alias": "jb-gray-2"
  },
  "keyboard-key-outline-color": {
   "$alias": "jb-gray-9"
  }
 },
 "shape": {
  "control-radius": {
   "value": 8,
   "$from": "Light: ui Component.arc = 8"
  },
  "button-radius": {
   "value": 8,
   "$from": "Light: ui Button.arc = 8"
  },
  "island-radius": null,
  "island-radius-compact": null,
  "island-gap": null,
  "island-gap-compact": null,
  "island-inactive-alpha": null
 },
 "font": {
  "font-family-ui": [
   "Segoe UI Variable Text",
   "Segoe UI",
   "Pretendard",
   "Malgun Gothic",
   "sans-serif"
  ],
  "font-family-display": [
   "Segoe UI Variable Display",
   "Segoe UI",
   "Pretendard",
   "Malgun Gothic",
   "sans-serif"
  ],
  "font-family-mono": [
   "JetBrains Mono",
   "Consolas",
   "Cascadia Mono",
   "monospace"
  ],
  "font-family-score-text": [
   "Liberation Serif",
   "Times New Roman",
   "serif"
  ],
  "font-feature-numbers": "tnum"
 },
 "typography": {
  "caption": {
   "size": 12,
   "line-height": 16,
   "weight": 400
  },
  "body": {
   "size": 14,
   "line-height": 20,
   "weight": 400
  },
  "body-strong": {
   "size": 14,
   "line-height": 20,
   "weight": 600
  },
  "body-large": {
   "size": 18,
   "line-height": 24,
   "weight": 400
  },
  "body-large-strong": {
   "size": 18,
   "line-height": 24,
   "weight": 600
  },
  "subtitle": {
   "size": 20,
   "line-height": 28,
   "weight": 600
  },
  "title": {
   "size": 28,
   "line-height": 36,
   "weight": 600
  },
  "title-large": {
   "size": 40,
   "line-height": 52,
   "weight": 600
  },
  "display": {
   "size": 68,
   "line-height": 92,
   "weight": 600
  }
 },
 "spacing": {
  "control": 8,
  "control-label": 12,
  "content-area": 12,
  "surface-edge": 16,
  "unit": 4,
  "target-min": 24,
  "icon": 16,
  "icon-list": 20,
  "icon-large": 24
 }
}